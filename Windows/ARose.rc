#include <windows.h>
#include "resource.h"
IDI_AROSE ICON "ARose.ico"
1 RT_MANIFEST "ARose.manifest"
IDD_SETTINGS DIALOGEX 0, 0, 280, 272
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ARose Settings"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Style", IDC_STYLE_LABEL, 12, 16, 65, 12
 COMBOBOX IDC_STYLE, 82, 12, 186, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Speed", IDC_SPEED_LABEL, 12, 44, 65, 12
 COMBOBOX IDC_SPEED, 82, 40, 186, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Trail", IDC_TRAIL_LABEL, 12, 72, 65, 12
 COMBOBOX IDC_TRAIL, 82, 68, 186, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Colors", IDC_PALETTE_LABEL, 12, 100, 65, 12
 COMBOBOX IDC_PALETTE, 82, 96, 186, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Glow", IDC_GLOW_LABEL, 12, 128, 65, 12
 CONTROL "", IDC_GLOW, "msctls_trackbar32", WS_TABSTOP | TBS_AUTOTICKS, 80, 122, 146, 24
 LTEXT "80 %", IDC_PERCENT, 232, 128, 36, 12
 LTEXT "Glow is available in Modern mode.", IDC_NOTE, 12, 152, 256, 22
 CONTROL "Debug: show process CPU usage", IDC_DEBUG_CPU, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 178, 256, 14
 CONTROL "Resume from last figure", IDC_RESUME_FIGURE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 198, 256, 14
 PUSHBUTTON "Forget saved figure", IDC_FORGET_FIGURE, 12, 218, 256, 18
 DEFPUSHBUTTON "Save", IDOK, 150, 246, 56, 16
 PUSHBUTTON "Cancel", IDCANCEL, 212, 246, 56, 16
END
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,3,4
 PRODUCTVERSION 1,0,3,4
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "ARose ScreenSaver\0"
   VALUE "FileVersion", "1.0.3\0"
   VALUE "ProductName", "ARose ScreenSaver\0"
   VALUE "ProductVersion", "1.0.3\0"
   VALUE "OriginalFilename", "ARose.scr\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
